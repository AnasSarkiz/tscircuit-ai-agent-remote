@@ -0,0 +1,106 @@
+import { expect, test } from "bun:test"
+import {
+  any_circuit_element,
+  pcb_component,
+  pcb_group,
+  schematic_group,
+} from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+import { ICS_43434 } from "tests/fixtures/ics43434-import/C5656610"
+
+test("ordinary groups and resolved component offsets conform to Circuit JSON without moving pads", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={40} height={30} routingDisabled>
+      <schematicsheet name="schema-review" sheetSize="A4">
+        <net name="GND" isGroundNet />
+        <net name="V3V3" isPowerNet />
+        <group name="G1" pcbX={5} pcbY={3}>
+          <ICS_43434 name="U1" pcbX={-2} pcbY={0} />
+          <ICS_43434 name="U2" pcbX="calc(U1.maxX + 3mm)" pcbY="0mm" />
+        </group>
+        <group name="G2" subcircuit pcbX={-8} pcbY={-5}>
+          <ICS_43434 name="U3" />
+        </group>
+        <pcbnotetext
+          text="Schema-valid positions: numeric, calc and absent offsets"
+          pcbY={11}
+        />
+      </schematicsheet>
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+
+  for (const pcbComponent of circuit.db.pcb_component.list()) {
+    expect(pcb_component.safeParse(pcbComponent).success).toBe(true)
+  }
+  for (const pcbGroup of circuit.db.pcb_group.list()) {
+    const parsedPcbGroup = pcb_group.safeParse(pcbGroup)
+    expect(parsedPcbGroup.success ? [] : parsedPcbGroup.error.issues).toEqual(
+      [],
+    )
+  }
+  for (const schematicGroup of circuit.db.schematic_group.list()) {
+    expect(schematic_group.safeParse(schematicGroup).success).toBe(true)
+  }
+  for (const circuitElement of circuit.getCircuitJson()) {
+    expect(any_circuit_element.safeParse(circuitElement).success).toBe(true)
+  }
+
+  const u1Source = circuit.db.source_component
+    .list()
+    .find((sourceComponent) => sourceComponent.name === "U1")
+  const u2Source = circuit.db.source_component
+    .list()
+    .find((sourceComponent) => sourceComponent.name === "U2")
+  const u3Source = circuit.db.source_component
+    .list()
+    .find((sourceComponent) => sourceComponent.name === "U3")
+  const u1Pcb = circuit.db.pcb_component
+    .list()
+    .find(
+      (pcbComponent) =>
+        pcbComponent.source_component_id === u1Source?.source_component_id,
+    )
+  const u2Pcb = circuit.db.pcb_component
+    .list()
+    .find(
+      (pcbComponent) =>
+        pcbComponent.source_component_id === u2Source?.source_component_id,
+    )
+  const u3Pcb = circuit.db.pcb_component
+    .list()
+    .find(
+      (pcbComponent) =>
+        pcbComponent.source_component_id === u3Source?.source_component_id,
+    )
+  const u1Pad1 = circuit.db.pcb_smtpad
+    .list()
+    .filter((smtPad) => smtPad.shape === "rect")
+    .find(
+      (smtPad) =>
+        smtPad.pcb_component_id === u1Pcb?.pcb_component_id &&
+        smtPad.port_hints?.includes("pin1"),
+    )
+  const u2Pad1 = circuit.db.pcb_smtpad
+    .list()
+    .filter((smtPad) => smtPad.shape === "rect")
+    .find(
+      (smtPad) =>
+        smtPad.pcb_component_id === u2Pcb?.pcb_component_id &&
+        smtPad.port_hints?.includes("pin1"),
+    )
+  // Imported pin 1 is (-1.3071856, -0.900049) mm from the footprint origin.
+  // Its asymmetric pad bounds make the emitted component center differ from that origin.
+  expect(u1Pad1?.x).toBeCloseTo(5 - 2 - 1.3071856, 7)
+  expect(u1Pad1?.y).toBeCloseTo(3 - 0.900049, 7)
+  expect(u2Pad1?.x).toBeCloseTo(3 + (u1Pcb?.width ?? 0) / 2 + 3 - 1.3071856, 7)
+  // The existing mixed calc placement resolves U2 in board space.
+  expect(u2Pad1?.y).toBeCloseTo(-0.900049, 7)
+  expect(u1Pcb?.display_offset_x).toBe("-2mm")
+  expect(u1Pcb?.display_offset_y).toBe("0mm")
+  expect(u3Pcb?.display_offset_x).toBeUndefined()
+  expect(u3Pcb?.display_offset_y).toBeUndefined()
+  expect(circuit).toMatchPcbSnapshot(import.meta.path, { showPcbGroups: true })
+  expect(circuit).toMatchSchematicSnapshot(import.meta.path)
+})
