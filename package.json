{
  "name": "@tsci/AnasSarkiz.tscircuit-ai-agent-remote",
  "version": "0.0.11-wip-generator-qualification",
  "description": "Handheld Wi-Fi AI agent remote; engineering prototype under validation",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "publish:prepare": "bun scripts/prepare-board-package.ts",
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "build:placement": "tsci build placement.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test ./tests",
    "cloud:setup": "bash scripts/cloud/setup.sh",
    "cloud:run": "python3 scripts/cloud/run_with_budget.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
