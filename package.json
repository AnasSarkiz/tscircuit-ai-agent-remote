    "@tscircuit/checks": "0.0.237",
    "@tscircuit/cli": "0.1.2270",
    "@tscircuit/core": "file:toolchain/packages/tscircuit-core-0.0.2090-board-fixes.3.tgz",
    "@tscircuit/modelprinter": "0.0.6",
    "@types/bun": "1.4.2",
    "@types/three": "0.179.0",
    "circuit-to-svg": "0.0.440",
    "easyeda": "0.0.370",
    "tscircuit": "0.0.2744",
    "typescript": "5.9.3",
    "circuit-json-to-gerber": "file:toolchain/packages/circuit-json-to-gerber-0.0.112-board-fixes.1.tgz"
  },
  "author": "AnasSarkiz",
  "private": true,
