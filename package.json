{
  "name": "@tsci/AnasSarkiz.tscircuit-ai-agent-remote",
  "version": "0.0.1",
  "description": "Handheld Wi-Fi AI agent remote; engineering prototype under validation",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "build:placement": "tsci build index.circuit.tsx --routing-disabled --pcb-png --pcb-svgs --schematic-svgs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test"
  },
  "devDependencies": {
    "tscircuit": "0.0.2729",
    "@tscircuit/cli": "0.1.2228",
    "typescript": "5.9.3",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2"
  },
  "author": "AnasSarkiz",
  "private": true
}
