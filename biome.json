{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!components/**",
      "!evidence/**",
      "!references/**",
      "!dist/**",
      "!.tscircuit/cache/**",
      "!routes/**",
      "!bun.lock",
      "!imports/**",
      "!.upstream-work/**",
      "!.publish/**",
      "!!.tools/**",
      "!!.geometry-runtime/**",
      "!toolchain/core/source/**",
      "!toolchain/circuit-json/source/**",
      "!toolchain/gerber/source/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double"
    }
  }
}
